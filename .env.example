# Dominio del centro, sin /api/v1. Ninguna credencial real en este archivo.
CANVAS_BASE_URL=https://medac.instructure.com
# Opcionales: solo para importar tu cuenta personal con --import-personal.
CANVAS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Obligatoria incluso en local. Generar: python -m src.main --generate-key
STATE_ENCRYPTION_KEY=
# Registro con tokens manuales permitido únicamente en este modo de prueba.
TEST_MODE=true
STORAGE_BACKEND=local
STATE_FILE=data/state.enc
TIMEZONE=Europe/Madrid
# Opcionales: IDs numéricos separados por coma y código de invitación de clase.
ALLOWED_TELEGRAM_USER_IDS=
CLASS_INVITE_CODE=
MAX_USERS=30
RECENT_DAYS=7
INITIAL_NOTIFICATIONS=false
# Solo para usar almacenamiento GitHub desde tu máquina; Actions los proporciona.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
STATE_BRANCH=bot-state
