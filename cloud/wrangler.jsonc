{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canvas-telegram-assistant",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": false },
  "d1_databases": [{
    "binding": "BOT_DB",
    "database_name": "canvas-telegram-assistant",
    "database_id": "87234ac0-3f4b-42e4-afb6-5983cc220e35"
  }]
}
